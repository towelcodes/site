---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Album from "../components/music/Album.astro";
import { getCollection } from "astro:content";

const music = await getCollection("music");
console.log(music);
---

<Layout title="music" accent="ctp-sky" returnHome>
    <div slot="body" class="relative">
        <div class="prose mb-2">
            <h1>music i like</h1>

            <p>
                <i>(i'll organise this one day)</i>
                <br />
                for more stats check out my <a
                    href="https://last.fm/user/teatowels"
                    class="text-ctp-red"
                    target="_blank">last.fm</a
                > or <a
                    href="https://listenbrainz.org/user/teatowel/stats/?range=this_month"
                    class="text-ctp-green"
                    target="_blank">listenbrainz</a
                >
            </p>
        </div>

        <div class="flex flex-wrap gap-2 mx-auto">
            {music.length == 0 && <p>no music found :(</p>}
            {
                music.map((album) => (
                    <Album
                        title={album.data.title}
                        artist={album.data.artist}
                        date={album.data.date}
                        cover={album.data.cover}
                    />
                ))
            }
        </div>
    </div>
</Layout>
